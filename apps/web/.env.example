# Salin menjadi .env.local dan isi. Jangan commit .env.local.

# Wajib: rahasia penanda sesi, minimal 16 karakter acak.
SESSION_SECRET=

# Wajib: kunci enkripsi file, 64 karakter heksadesimal (32 byte).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=

# Pembacaan gambar AI. Penyedia: gemini (bawaan) atau claude.
PEMBACA_AI=gemini
# Gemini: kunci dari Google AI Studio.
GEMINI_API_KEY=
# Opsional. Bawaan: gemini-flash-lite-latest (jalan di kunci gratis). Akun berbayar: gemini-pro-latest.
GEMINI_MODEL=
# Hanya bila PEMBACA_AI=claude.
ANTHROPIC_API_KEY=
# Opsional. Bawaan: claude-opus-5-5
ANTHROPIC_MODEL=

# Opsional. Kosong = Postgres tertanam (PGlite) di apps/web/.data/pglite untuk pengembangan.
# Produksi: postgres://user:pass@host:5432/estimasi
DATABASE_URL=

# Opsional. Folder file terenkripsi. Bawaan: apps/web/.data/berkas
BERKAS_DIR=
# Opsional. Python dengan PyMuPDF. Bawaan: workers/.venv
PYTHON_BIN=

# Hanya untuk `npm run db:seed` (admin pertama).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Opsional. Chrome/Chromium untuk membuat PDF hasil. Bawaan: dicari otomatis (Chrome atau Edge di Windows).
CHROME_PATH=
